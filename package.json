{
  "name": "opencode-dashscope-imagegen",
  "version": "0.1.2",
  "description": "OpenCode plugin that adds an image_generate tool for text-to-image generation with Alibaba DashScope models (qwen-image-2.0, qwen-image-3.0, wan2.7-image)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-ai",
    "plugin",
    "dashscope",
    "alibaba",
    "aliyun",
    "bailian",
    "qwen",
    "qwen-image",
    "wan",
    "image-generation",
    "text-to-image",
    "image",
    "imagegen",
    "ai",
    "ai-image",
    "typescript"
  ],
  "license": "MIT",
  "author": "WhiteBite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteBite/opencode-dashscope-imagegen.git"
  },
  "homepage": "https://github.com/WhiteBite/opencode-dashscope-imagegen#readme",
  "bugs": {
    "url": "https://github.com/WhiteBite/opencode-dashscope-imagegen/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.19"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
